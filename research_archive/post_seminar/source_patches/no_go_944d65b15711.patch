+
+    def _get_batch(self, key):
+        return self._batches.get(key)
+
+    def _put_batch(self, key, value: bool) -> bool:
+        self._batches[key] = value
+        return value
+
+    def _get_batch_receipt(self, key):
+        return self._batch_receipts.get(key)
