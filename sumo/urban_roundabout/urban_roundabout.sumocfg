<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="urban_roundabout.net.xml"/>
        <route-files value="urban_roundabout.rou.xml"/>
        <additional-files value="rsus.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="95"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
